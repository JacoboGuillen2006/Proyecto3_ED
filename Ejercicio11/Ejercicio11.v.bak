// Diagrama de estados de Moore (Ejercicio 11)
module Ejercicio11 (
    input       ix,
    input       iCLK,
    input       iRST,
    output [1:0] oAB
);

    reg [1:0] state;
    
    // Asignación de parámetros binarios de 2 bits para los estados S0 a S3[cite: 9, 10]
    parameter S0 = 2'b00, S1 = 2'b01, S2 = 2'b10, S3 = 2'b11;[cite: 9, 10]

    // Transiciones de estado sincrónicas con el reloj y restablecimiento asincrónico[cite: 10]
    always @ (posedge iCLK or negedge iRST) begin[cite: 10]
        if (~iRST)
            state <= S0;   // Iniciar en el estado inicial S0 (reset)[cite: 10]
        else begin
            case (state)[cite: 10]
                S0: if (~ix) state <= S1; else state <= S0;[cite: 10]
                S1: if (ix)  state <= S2; else state <= S3;[cite: 10]
                S2: if (~ix) state <= S3; else state <= S2;[cite: 10]
                S3: if (~ix) state <= S0; else state <= S3;[cite: 10]
                default: state <= S0;
            endcase
        end
    end

    assign oAB = state;   // Salida directa de los flip-flops (Modelo Moore)[cite: 9, 10]

endmodule